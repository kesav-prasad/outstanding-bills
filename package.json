{
  "name": "outstanding-bills",
  "private": true,
  "version": "1.0.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/kesav-prasad/outstanding-bills.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder -w --x64",
    "release:win": "vite build && electron-builder -w --x64 --publish always",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^4.0.0",
    "lucide-react": "^0.407.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.2.13",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.outstanding.bills",
    "productName": "Outstanding Bills",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "kesav-prasad",
      "repo": "outstanding-bills",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "postcss": {}
}
